menu "MQTT Configuration"
    
    menuconfig MQTT_EN
        bool "Enable MQTT"
        default n
        help
            Enable MQTT functionality.

        config MQTT_BROKER_HOST
            string "MQTT Broker Host"
            default "mqtt://broker.com"
            depends on MQTT_EN
            help
                Host of the MQTT broker.

        config MQTT_BROKER_PORT
            int "Broker port"
            default 1883
            depends on MQTT_EN
            help
                Broker port

        config MQTT_TOPIC
            string "Topic"
            default "haier"
            depends on MQTT_EN
            help
                MQTT high level topic

        menuconfig MQTT_AUTH_EN
            bool "Enable MQTT Autentification"
            default n
            depends on MQTT_EN
            help
                Enable MQTT autentification.

            config MQTT_USER
                string "Username"
                default "user"
                depends on MQTT_AUTH_EN
                help
                    MQTT username

            config MQTT_PASSWORD
                string "Password"
                default "password"
                depends on MQTT_AUTH_EN
                help
                    MQTT password

        menuconfig MQTT_TLS_EN
            bool "Enable MQTT TLS"
            default n
            depends on MQTT_EN
            help
                Enable MQTT TLS.
                mqtt_cert.pem file should be provided.

        menuconfig MQTT_LWT_EN
            bool "Enable MQTT LWT functionality"
            default n
            depends on MQTT_EN
            help
                Enable MQTT LWT functionality.

            config MQTT_LWT_SUBTOPIC
                string "LWT subtopic"
                default "lwt"
                depends on MQTT_LWT_EN
                help
                    LWT subtopic

            config MQTT_LWT_ONLINE_MSG
                string "LWT online message"
                default "online"
                depends on MQTT_LWT_EN
                help
                    LWT online message

            config MQTT_LWT_PERIOD
                int "LWT sending period"
                default 10000
                depends on MQTT_LWT_EN
                help
                    LWT sending period
endmenu
