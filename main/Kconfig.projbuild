menu "Controller Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
        SSID (network name) for the example to connect to.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
        WiFi password (WPA or WPA2) for the example to use.

    menuconfig TG_EN
        bool "Enable Telegram bot"
        default y
        help
            Enable Tegeram bot functionality.

        if TG_EN
            config TG_BOT_TOKEN
                string "Telegram Bot Token"
                default "token"
                help
                Telegram Bot Token.

            config TG_CHAT_ID
                int "Telegram chat ID"
                default 1
                help
                    Accepted chat ID

        endif # TG_EN

    menuconfig MQTT_EN
        bool "Enable MQTT"
        default n
        help
            Enable MQTT functionality.

        config MQTT_BROKER_HOST
            string "MQTT Broker Host"
            default "mqtt://broker.com"
            depends on MQTT_EN
            help
                Host of the MQTT broker.

        config MQTT_BROKER_PORT
            int "Broker port"
            default 1883
            depends on MQTT_EN
            help
                Broker port

        config MQTT_TOPIC
            string "Topic"
            default "haier"
            depends on MQTT_EN
            help
                MQTT high level topic

        menuconfig MQTT_AUTH_EN
            bool "Enable MQTT Autentification"
            default n
            depends on MQTT_EN
            help
                Enable MQTT autentification.

            config MQTT_USER
                string "Username"
                default "user"
                depends on MQTT_AUTH_EN
                help
                    MQTT username

            config MQTT_PASSWORD
                string "Password"
                default "password"
                depends on MQTT_AUTH_EN
                help
                    MQTT password

        menuconfig MQTT_TLS_EN
            bool "Enable MQTT TLS"
            default n
            depends on MQTT_EN
            help
                Enable MQTT TLS.
endmenu
